* text=auto eol=lf
*.rs text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.ps1 text eol=crlf
*.png binary
*.ico binary
# Preserve third-party license bytes, including upstream whitespace.
licenses/* -text -whitespace
# Preserve checksummed pet package and source asset bytes across Git checkouts.
assets/pets/** -text -whitespace
