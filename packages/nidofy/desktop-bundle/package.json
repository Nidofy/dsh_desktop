{
  "name": "@nidofy/dsh-desktop-bundle",
  "version": "0.2.0-rc.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./context-presets.patch.yml": "./context-presets.patch.yml",
    "./secure-credentials.patch.yml": "./secure-credentials.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/types/*.d.ts",
    "cordis.patch.yml",
    "context-presets.patch.yml",
    "secure-credentials.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "@nidofy/dsh-secure-credentials": "workspace:*",
    "@nidofy/dsh-desktop-extras": "workspace:*",
    "@deepseek-ai/dsh-tool-session-query": "workspace:*",
    "@nidofy/dsh-working-notebook": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./context-presets.patch.yml"
      ]
    }
  }
}
