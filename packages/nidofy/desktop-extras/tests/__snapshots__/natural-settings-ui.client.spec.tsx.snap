// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`cancels a pending preview, ignores late controls and permits a new explicit preview > cancelled waiting preserves owner uncertainty 1`] = `
<DocumentFragment>
  <details
    class="nidofy-control-fold"
    open=""
  >
    <summary>
      Settings in words
    </summary>
    <div
      class="nidofy-detail nidofy-settings"
    >
      <p>
        Choose one listed action or type one finite instruction. Selection only fills the instruction; preview and confirmation are separate. No model request is sent.
      </p>
      <label
        for=":r0:"
      >
        Available actions
      </label>
      <select
        id=":r0:"
      >
        <option
          value=""
        >
          Choose an action
        </option>
        <option
          value="follow"
        >
          Follow this conversation
        </option>
        <option
          value="unfollow"
        >
          Stop following
        </option>
        <option
          value="connections"
        >
          Open connections
        </option>
        <option
          value="builds"
        >
          Open workbench
        </option>
        <option
          value="pets"
        >
          Open pet settings
        </option>
        <option
          value="bind"
        >
          Bind pet
        </option>
        <option
          value="unbind"
        >
          Unbind pet
        </option>
        <option
          value="mute"
        >
          Mute pet
        </option>
        <option
          value="unmute"
        >
          Unmute pet
        </option>
        <option
          value="interact"
        >
          Wave to pet
        </option>
        <option
          value="toneOn"
        >
          Enable companion tone
        </option>
        <option
          value="toneOff"
        >
          Disable companion tone
        </option>
      </select>
      <label>
        One instruction
        <input
          maxlength="512"
          value="Please follow this conversation."
        />
      </label>
      <dl
        class="nidofy-settings-target"
      >
        <dt>
          Foreground conversation
        </dt>
        <dd>
          None
        </dd>
        <dt>
          Foreground workspace
        </dt>
        <dd>
          None
        </dd>
        <dt>
          Selected pet
        </dt>
        <dd>
          Not used by this action
        </dd>
      </dl>
      <button>
        Preview setting
      </button>
      <button>
        Read current settings
      </button>
      <p
        role="status"
      >
        Waiting cancelled. The owner may already have applied the action. Check the actual setting before a new preview.
      </p>
    </div>
  </details>
</DocumentFragment>
`;

