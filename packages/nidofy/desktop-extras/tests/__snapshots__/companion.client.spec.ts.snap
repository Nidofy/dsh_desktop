exports[`shares one character slot across wide and narrow layouts, visibility and both locales without acquiring extra Session references > zh-narrow 1`] = `"<section class="nidofy-environment" aria-label="环境信息"><header><button class="nidofy-collapse" aria-expanded="false" aria-controls="nidofy-environment-body"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h18v16H3z M15 4v16"></path></svg><span>环境信息</span><span aria-hidden="true">+</span></button></header></section><section class="nidofy-companion" aria-label="小鲸"><div class="nidofy-companion-caption"><strong>小鲸</strong><p role="status">回合进行中</p><p>模型选择未知</p><p>工作笔记不可用</p></div><nav aria-label="工作区工具"><button disabled=""><span>打开待处理审批</span></button><button><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 5-5 7 5 7 M16 5l5 7-5 7 M14 3l-4 18"></path></svg><span>构建与测试</span></button><button><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11 3 4l7 4h4l7-4-2 7v5c0 7-14 7-14 0z M8 14h1 M15 14h1"></path></svg><span>桌宠</span></button><button><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h7l2 3h9v12H3z"></path></svg><span>产物</span></button></nav><div class="nidofy-companion-controls"><div class="nidofy-inline-actions nidofy-follow-actions"><button>关注当前会话</button><button aria-expanded="false">近期事实</button></div><details class="nidofy-control-fold"><summary>桌宠关注</summary><div class="nidofy-detail nidofy-pet-settings"><label for=":r2e:">桌宠实例 ID</label><select id=":r2e:" disabled=""></select><button>刷新已配置桌宠<