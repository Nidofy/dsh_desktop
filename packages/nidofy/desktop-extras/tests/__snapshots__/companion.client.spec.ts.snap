exports[`shares one character slot across wide and narrow layouts, visibility and both locales without acquiring extra Session references > en-narrow 1`] = `"<section class="nidofy-environment" aria-label="Environment"><header><button class="nidofy-collapse" aria-expanded="false" aria-controls="nidofy-environment-body"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h18v16H3z M15 4v16"></path></svg><span>Environment</span><span aria-hidden="true">+</span></button></header></section><section class="nidofy-companion" aria-label="Companion"><div class="nidofy-companion-caption"><strong>Companion</strong><p role="status">Turn in progress</p><p>Model selection unknown</p><p>Working notes unavailable</p></div><nav aria-label="Workspace tools"><button disabled=""><span>Open pending approval</span></button><button><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 5-5 7 5 7 M16 5l5 7-5 7 M14 3l-4 18"></path></svg><span>Build and test</span></button><button><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11 3 4l7 4h4l7-4-2 7v5c0 7-14 7-14 0z M8 14h1 M15 14h1"></path></svg><span>Desktop pet</span></button><button><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h7l2 3h9v12H3z"></path></svg><span>Files</span></button></nav><div class="nidofy-companion-controls"><div class="nidofy-inline-actions nidofy-follow-actions"><button>Follow this conversation</button><button aria-expanded="false">Recent facts</button></div><details class="nidofy-control-fold"><summary>Desktop pet attention</summary><div class="nidofy-detail nidofy-pet-settings"><label for=":r2e:">Pet instance ID</label><select id=":r2e:" disabled=""></select><button>Refresh configured pets</button><p role="status">Loading…</p><div class="nidofy-inline-actions"><button disabled="">Bind this conversation</button><button disabled="">Release binding</button><button disabled="">Mute pet bubbles</button><button disabled="">Enable pet bubbles</button><button disabled="">Wave locally</button></div><p>Binding follows this conversation. Enable the pet in Personal extensions first; these choices send no model requests.</p></div></details><button class="nidofy-control-row" aria-expanded="false" disabled="">Side analysis</button></div><div class="nidofy-character"><div data-slot="nidofy.companion" style="display: contents;"><span data-companion-test="">working</span></div></div></section>"`;

