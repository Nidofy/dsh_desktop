exports[`shares one character slot across wide and narrow layouts, visibility and both locales without acquiring extra Session references > zh-narrow 1`] = `"<section class="nidofy-companion" aria-label="伙伴"><header class="nidofy-panel-top"><div class="nidofy-mode-tabs" role="tablist" aria-label="伙伴模式"><button id=":r31:-assistant" role="tab" aria-selected="true" aria-controls=":r31:-panel" tabindex="0">助手</button><button id=":r31:-project" role="tab" aria-selected="false" aria-controls=":r31:-panel" tabindex="-1">项目</button><button id=":r31:-tools" role="tab" aria-selected="false" aria-controls=":r31:-panel" tabindex="-1">工具</button></div><details class="nidofy-panel-more"><summary aria-label="伙伴面板更多操作">⋯</summary><div><button>角色显示</button><button>桌宠</button><button>状态详情</button><button>恢复面板布局</button></div></details></header><button class="nidofy-project-context" aria-label="查看当前项目环境"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" stroke-width="1"><path d="M13.5 1.5H2.5C1.94772 1.5 1.5 1.94772 1.5 2.5V13.5C1.5 14.0523 1.94772 14.5 2.5 14.5H13.5C14.0523 14.5 14.5 14.0523 14.5 13.5V2.5C14.5 1.94772 14.0523 1.5 13.5 1.5Z" stroke="currentColor"></path><path d="M5.5 1.5V14.5" stroke="currentColor"></path></svg><span><strong>当前项目</strong><small>环境未读取</small></span><span aria-hidden="true">›</span></button><div class="nidofy-status-strip"><p role="status"><span class="nidofy-status-dot" data-state="working"></span><span>正在处理</span><button aria-label="状态详情">ⓘ</button></p></div><div class="nidofy-mode-panel" role="tabpanel" id=":r31:-panel" aria-labelledby=":r31:-assistant"><div class="nidofy-stage-region" data-compact="false"><section class="nidofy-stage" aria-label="角色舞台"><header><small>角色舞台</small><button aria-label="角色显示">⚙</button></header><div class="nidofy-character"><div data-slot="nidofy.companion" style="display: contents;"><span data-companion-test="">working</span></div></div><div class="nidofy-frame-tools"><button aria-pressed="false" disabled="" title="此角色未提供取景控制能力。">全身</button><button aria-pressed="true" disabled="" title="此角色未提供取景控制能力。">半身</button><button aria-pressed="false" disabled="" title="此角色未提供取景控制能力。">头像</button><button aria-label="重置角色取景" disabled="">⟲</button></div></section></div><div class="nidofy-mode-actions"><div class="nidofy-primary-actions"><button disabled="">工作笔记</button><button>最近进展</button></div><div class="nidofy-secondary-actions"><button>关注当前会话</button><button>桌宠关注 ›</button></div></div></div></section>"`;

exports[`shows source-labelled bilingual rules, persists independent ignore choices and suppresses offered cards on fast return > hints-en 1`] = `"<p>Observed notices: 0</p><article><p>An active working note still needs attention</p><p>User correction remains active</p><p>Source: user-note</p><div class="nidofy-inline-actions"><button>Working notes and history</button><button>Ignore this hint</button><button>Snooze for 15 minutes</button></div></article><article><p>The installed connection editor is available</p><p>Source: connections</p><div class="nidofy-inline-actions"><button>Connections</button><button>Ignore this hint</button><button>Snooze for 15 minutes</button></div></article><div class="nidofy-inline-actions"><button>Reset all Hint viewing preferences</button></div><p>No verification receipt observed</p><p>A completed turn does not establish that tests passed. Read the verification receipt for its result.</p><div><p>Committed notes, revision 1</p><p>User correction remains active</p></div>"`;

exports[`shows source-labelled bilingual rules, persists independent ignore choices and suppresses offered cards on fast return > hints-zh 1`] = `"<p>已观察通知：0</p><article><p>已提交的活动笔记仍有待关注事项</p><p>User correction remains active</p><p>来源：user-note</p><div class="nidofy-inline-actions"><button>工作笔记与历史</button><button>忽略此提示</button><button>暂缓 15 分钟</button></div></article><article><p>已安装的连接编辑器可用</p><p>来源：connections</p><div class="nidofy-inline-actions"><button>连接</button><button>忽略此提示</button><button>暂缓 15 分钟</button></div></article><div class="nidofy-inline-actions"><button>重置全部 Hint 展示偏好</button></div><p>尚未观察到验证回执</p><p>回合结束不表示测试通过，请读取验证回执中的结果。</p><div><p>已提交笔记，第 1 版</p><p>User correction remains active</p></div>"`;
