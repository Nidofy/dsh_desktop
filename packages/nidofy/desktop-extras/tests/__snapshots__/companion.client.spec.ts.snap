exports[`shows source-labelled bilingual rules, persists independent ignore choices and suppresses offered cards on fast return > hints-en 1`] = `"<p>Observed notices: 0</p><article><p>An active working note still needs attention</p><p>User correction remains active</p><p>Source: user-note</p><div class="nidofy-inline-actions"><button>Working notes and history</button><button>Ignore this hint</button><button>Snooze for 15 minutes</button></div></article><article><p>The installed connection editor is available</p><p>Source: connections</p><div class="nidofy-inline-actions"><button>Connections</button><button>Ignore this hint</button><button>Snooze for 15 minutes</button></div></article><div class="nidofy-inline-actions"><button>Reset all Hint viewing preferences</button></div><p>No verification receipt observed</p><p>A completed turn does not establish that tests passed. Read the verification receipt for its result.</p><div><p>Committed notes, revision 1</p><p>User correction remains active</p></div>"`;

exports[`shows source-labelled bilingual rules, persists independent ignore choices and suppresses offered cards on fast return > hints-zh 1`] = `"<p>已观察通知：0</p><article><p>已提交的活动笔记仍有待关注事项</p><p>User correction remains active</p><p>来源：user-note</p><div class="nidofy-inline-actions"><button>工作笔记与历史</button><button>忽略此提示</button><button>暂缓 15 分钟</button></div></article><article><p>已安装的连接编辑器可用</p><p>来源：connections</p><div class="nidofy-inline-actions"><button>连接</button><button>忽略此提示</button><button>暂缓 15 分钟</button></div></article><div class="nidofy-inline-actions"><button>重置全部 Hint 展示偏好</button></div><p>尚未观察到验证回执</p><p>回合结束不表示测试通过，请读取验证回执中的结果。</p><div><p>已提交笔记，第 1 版</p><p>User correction remains active</p></div>"`;
