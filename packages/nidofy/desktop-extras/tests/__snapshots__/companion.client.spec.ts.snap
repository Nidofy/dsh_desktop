exports[`shares one character slot across wide and narrow layouts, visibility and both locales without acquiring extra Session references > en-narrow 1`] = `"<section class="nidofy-companion" aria-label="Companion"><header class="nidofy-panel-top"><div class="nidofy-mode-tabs" role="tablist" aria-label="Companion modes"><button id=":r31:-assistant" role="tab" aria-selected="true" aria-controls=":r31:-panel" tabindex="0">Assistant</button><button id=":r31:-project" role="tab" aria-selected="false" aria-controls=":r31:-panel" tabindex="-1">Project</button><button id=":r31:-tools" role="tab" aria-selected="false" aria-controls=":r31:-panel" tabindex="-1">Tools</button></div><details class="nidofy-panel-more"><summary aria-label="More companion options">⋯</summary><div><button>Character display</button><button>Desktop pet</button><button>Status details</button><button>Reset panel layout</button></div></details></header><button class="nidofy-project-context" aria-label="View project environment"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" stroke-width="1"><path d="M13.5 1.5H2.5C1.94772 1.5 1.5 1.94772 1.5 2.5V13.5C1.5 14.0523 1.94772 14.5 2.5 14.5H13.5C14.0523 14.5 14.5 14.0523 14.5 13.5V2.5C14.5 1.94772 14.0523 1.5 13.5 1.5Z" stroke="currentColor"></path><path d="M5.5 1.5V14.5" stroke="currentColor"></path></svg><span><strong>Current project</strong><small>Environment not read</small></span><span aria-hidden="true">›</span></button><div class="nidofy-status-strip"><p role="status"><span class="nidofy-status-dot" data-state="working"></span><span>Turn in progress</span><button aria-label="Status details">ⓘ</button></p></div><div class="nidofy-mode-panel" role="tabpanel" id=":r31:-panel" aria-labelledby=":r31:-assistant"><div class="nidofy-stage-region" data-compact="false"><section class="nidofy-stage" aria-label="Character stage"><header><small>Character stage</small><button aria-label="Character display">⚙</button></header><div class="nidofy-character"><div data-slot="nidofy.companion" style="display: contents;"><span data-companion-test="">working</span></div></div><div class="nidofy-frame-tools"><button aria-pressed="false" disabled="" title="This character does not report framing controls.">Full</button><button aria-pressed="true" disabled="" title="This character does not report framing controls.">Half</button><button aria-pressed="false" disabled="" title="This character does not report framing controls.">Portrait</button><button aria-label="Reset character framing" disabled="">⟲</button></div></section></div><div class="nidofy-mode-actions"><div class="nidofy-primary-actions"><button disabled="">Working notes</button><button>Recent progress</button></div><div class="nidofy-secondary-actions"><button>Follow this conversation</button><button>Desktop pet attention ›</button></div></div></div></section>"`;

